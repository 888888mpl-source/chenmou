local function toggleBombESP(state)
    ESPConfig.Bomb.enabled = state

    if state then
        bombConnections.main = workspace.DescendantAdded:Connect(function(v)
            if v.Name == "SubspaceTripmine" and v:IsA("Model") then
                task.wait(0.2)
                createBombESP(v)
            end
        end)

        for i, v in pairs(workspace:GetDescendants()) do
            if v.Name == "SubspaceTripmine" and v:IsA("Model") then
                createBombESP(v)
            end
        end
    else
        if bombConnections.main then
            bombConnections.main:Disconnect()
            bombConnections.main = nil
        end
        
        for model, connection in pairs(bombConnections) do
            if model and model.Parent and model.Name == "SubspaceTripmine" then
                if connection then
                    connection:Disconnect()
                end
                removeBombESP(model)
            end
        end
        bombConnections = {}
    end
end

