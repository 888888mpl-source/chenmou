local ESPConfig = {
    Generator = {
        enabled = false,
        color = Color3.fromRGB(0, 255, 0)
    },
    Bomb = {
        enabled = false,
        color = Color3.fromRGB(255, 0, 0)
    },
    TextSize = 18
}

local generatorConnections = {}
local bombConnections = {}
local localPlayer = game:GetService("Players").LocalPlayer

local function getDistance(fromPosition)
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return math.floor((localPlayer.Character.HumanoidRootPart.Position - fromPosition).Magnitude)
    end
    return "N/A"
end

local function getBombPosition(model)
    local bombPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if bombPart then
        return bombPart.Position
    end
    return model.Position or Vector3.new(0, 0, 0)
end

local function createGeneratorESP(model)
    if model:FindFirstChild("Progress") and model.Progress.Value >= 100 then
        removeGeneratorESP(model)
        return
    end

    if not model.PrimaryPart then
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                model.PrimaryPart = part
                break
            end
        end
    end

    if not model:FindFirstChild("GeneratorHighlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "GeneratorHighlight"
        highlight.Adornee = model
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = ESPConfig.Generator.color
        highlight.OutlineColor = ESPConfig.Generator.color
        highlight.FillTransparency = 0.3
        highlight.OutlineTransparency = 0
        highlight.Parent = model
    end

    if not model:FindFirstChild("GeneratorBillboard") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GeneratorBillboard"
        billboard.Adornee = model.PrimaryPart
        billboard.Size = UDim2.new(0, 200, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 500
        billboard.Parent = model

        local label = Instance.new("TextLabel")
        label.Name = "TextLabel"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextSize = ESPConfig.TextSize
        label.TextWrapped = false
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Font = Enum.Font.Oswald
        
        local stroke = Instance.new("UIStroke")
        stroke.Parent = label
        stroke.Thickness = 1
        stroke.Color = Color3.new(0, 0, 0)
        stroke.Transparency = 0
        
        label.Parent = billboard
    end

    local billboard = model:FindFirstChild("GeneratorBillboard")
    local highlight = model:FindFirstChild("GeneratorHighlight")
    
    if billboard and billboard:FindFirstChild("TextLabel") then
        local label = billboard.TextLabel
        local distanceText = string.format("%d", getDistance(model.PrimaryPart.Position))
        
        if model:FindFirstChild("Progress") then
            local percent = math.floor(model.Progress.Value)
            local progressText = string.format("%d%%", percent)
            label.Text = string.format("发电机丨进度:%s丨距离:%s", progressText, distanceText)
        else
            label.Text = string.format("发电机丨进度:0%%丨距离:%s", distanceText)
        end
        
        label.TextColor3 = ESPConfig.Generator.color
    end
    
    if highlight then
        highlight.FillColor = ESPConfig.Generator.color
        highlight.OutlineColor = ESPConfig.Generator.color
    end
end

local function removeGeneratorESP(model)
    local billboard = model:FindFirstChild("GeneratorBillboard")
    if billboard then
        billboard:Destroy()
    end
    local highlight = model:FindFirstChild("GeneratorHighlight")
    if highlight then
        highlight:Destroy()
    end
end

local function toggleGeneratorESP(state)
    ESPConfig.Generator.enabled = state
    
    if state then
        task.spawn(function()
            local map = workspace:FindFirstChild("Map")
            if map and map:FindFirstChild("Ingame") and map.Ingame:FindFirstChild("Map") then
                for _, model in ipairs(map.Ingame.Map:GetChildren()) do
                    if model.Name == "Generator" then
                        if model:FindFirstChild("Progress") and model.Progress.Value >= 100 then
                            removeGeneratorESP(model)
                        else
                            createGeneratorESP(model)
                        end
                    end
                end
            end
        end)
        
        generatorConnections.update = game:GetService("RunService").Heartbeat:Connect(function()
            if not ESPConfig.Generator.enabled then return end
            
            local map = workspace:FindFirstChild("Map")
            if map and map:FindFirstChild("Ingame") and map.Ingame:FindFirstChild("Map") then
                for _, model in ipairs(map.Ingame.Map:GetChildren()) do
                    if model.Name == "Generator" then
                        if model:FindFirstChild("Progress") and model.Progress.Value >= 100 then
                            removeGeneratorESP(model)
                        else
                            createGeneratorESP(model)
                        end
                    end
                end
            end
        end)
    else
        if generatorConnections.update then
            generatorConnections.update:Disconnect()
            generatorConnections.update = nil
        end
        
        local map = workspace:FindFirstChild("Map")
        if map and map:FindFirstChild("Ingame") and map.Ingame:FindFirstChild("Map") then
            for _, model in ipairs(map.Ingame.Map:GetChildren()) do
                if model.Name == "Generator" then
                    removeGeneratorESP(model)
                end
            end
        end
    end
end

local function createBombESP(model)
    if not model:FindFirstChild("BombHighlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "BombHighlight"
        highlight.Adornee = model
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = ESPConfig.Bomb.color
        highlight.OutlineColor = ESPConfig.Bomb.color
        highlight.FillTransparency = 0.78
        highlight.OutlineTransparency = 0
        highlight.Parent = model
    end

    if not model:FindFirstChild("BombBillboard") then
        local bombPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        if not bombPart then return end
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "BombBillboard"
        billboard.Parent = model
        billboard.Adornee = bombPart
        billboard.Size = UDim2.new(0, 200, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 500

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Parent = billboard
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = ESPConfig.Bomb.color
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.TextScaled = false
        nameLabel.TextSize = ESPConfig.TextSize
        nameLabel.Font = Enum.Font.Oswald
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        
        local stroke = Instance.new("UIStroke")
        stroke.Parent = nameLabel
        stroke.Thickness = 1
        stroke.Color = Color3.new(0, 0, 0)
        stroke.Transparency = 0
        
        local function updateBombInfo()
            if not model or not model.Parent then return end
            local distance = getDistance(getBombPosition(model))
            nameLabel.Text = string.format("炸弹丨距离:%d", distance)
        end
        
        updateBombInfo()
        
        local infoConnection = game:GetService("RunService").Heartbeat:Connect(updateBombInfo)
        bombConnections[model] = infoConnection
    end
