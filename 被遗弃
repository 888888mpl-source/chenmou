                    end
                end
            end
            
        elseif config_114514.VisualStyle == "分段圆环" then
            local segments = #visualizationParts
            for i, part in ipairs(visualizationParts) do
                local angle1 = (i - 1) * (2 * math.pi / segments)
                local angle2 = i * (2 * math.pi / segments)
                local midAngle = (angle1 + angle2) / 2
                
                local x = center.X + radius * math.cos(midAngle)
                local z = center.Z + radius * math.sin(midAngle)
                
                part.Position = Vector3.new(x, center.Y, z)
                
                if isDanger then
                    if i % 2 == 0 then
                        part.BrickColor = BrickColor.new("Bright red")
                    else
                        part.BrickColor = BrickColor.new("Bright orange")
                    end
                else
                    if i % 2 == 0 then
                        part.BrickColor = BrickColor.new("Bright green")
                    else
                        part.BrickColor = BrickColor.new("Lime green")
                    end
                end
            end
            
        elseif config_114514.VisualStyle == "3D圆环" then
            for _, part in ipairs(visualizationParts) do
