local function getVibrantColor(color)
    local h, s, v = Color3.toHSV(color)
    s = math.min(1, s * 1.3)
    v = math.min(1, v * 1.1)
    return Color3.fromHSV(h, s, v)
end

local function getDarkerColor(color)
    local h, s, v = Color3.toHSV(color)
    v = v * 0.7
    return Color3.fromHSV(h, s, v)
end

