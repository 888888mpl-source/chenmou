-- 检测当前注入器
local function GetExecutor()
    if identifyexecutor then
        return identifyexecutor()
    end
    if getexecutorname then
        return getexecutorname()
    end

    if syn and syn.request then
        return "Synapse X"
    elseif fluxus then
        return "Fluxus"
    elseif KRNL_LOADED then
        return "KRNL"
    elseif is_sirhurt_closure then
        return "SirHurt"
    elseif pebc_execute then
        return "ProtoSmasher"
    elseif Wrath_LOADED then
        return "Wrath"
    elseif getgenv().IsSentinel then
        return "Sentinel"
    elseif getgenv().IS_COPERA then
        return "Copera"
    elseif getgenv().Evon then
        return "Evon"
    elseif getgenv().Comet then
        return "Comet"
    elseif getgenv().Valyse then
        return "Valyse"
    elseif getgenv().Delta then
        return "Delta"
    elseif getgenv().Solara then
        return "Solara"
    elseif getgenv().Wave then
        return "Wave"
    elseif getgenv().Codex then
        return "Codex"
    elseif getgenv().Swift then
        return "Swift"
    elseif getgenv().Xeno then
        return "Xeno"
    elseif getgenv().Potassium then
        return "Potassium"
    end

    return "未知注入器"
end

